<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/layout_edit_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- Top bar: Plugin name & Test URL -->
    <LinearLayout
        android:id="@+id/layout_edit_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@color/colorPrimary">

        <com.hwanyu365.pagetune.ui.view.NoAutofillEditText
            android:id="@+id/et_inp_pname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/edit_hint_tune_name"
            android:textColor="@color/colorWhite"
            android:textColorHint="@color/colorTextSecondary"
            android:backgroundTint="@color/colorWhite"
            android:inputType="textNoSuggestions"
            android:importantForAutofill="no"
            android:privateImeOptions="com.samsung.android.inputmethod.disableAutofill=true,disableAutofill=true"
            android:autofillHints="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <com.hwanyu365.pagetune.ui.view.NoAutofillEditText
                android:id="@+id/et_inp_taddr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/edit_hint_url"
                android:textColor="@color/colorWhite"
                android:textColorHint="@color/colorTextSecondary"
                android:backgroundTint="@color/colorWhite"
                android:inputType="textUri|textNoSuggestions"
                android:importantForAutofill="no"
                android:privateImeOptions="com.samsung.android.inputmethod.disableAutofill=true,disableAutofill=true"
                android:autofillHints="" />

            <Button
                android:id="@+id/btn_load_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/edit_load"
                android:backgroundTint="@color/colorAccent"
                android:textColor="@color/colorOnAccent" />

        </LinearLayout>

    </LinearLayout>

    <!-- Mid layout: WebView with Element Inspector overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/wv_inspector"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating Indicator when Inspector Mode is ON (Semi-transparent Orange) -->
        <TextView
            android:id="@+id/tv_inspector_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="#B3FF9800"
            android:textColor="@color/colorWhite"
            android:textStyle="bold"
            android:textSize="12sp"
            android:text="@string/edit_pick_banner"
            android:visibility="gone" />

    </FrameLayout>

    </LinearLayout>

    <!-- Bottom sheet: handle, toggle and save/cancel stay visible when collapsed -->
    <LinearLayout
        android:id="@+id/layout_bottom_config_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorGrayLight"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        app:behavior_hideable="false"
        app:behavior_fitToContents="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <FrameLayout
            android:id="@+id/sheet_handle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@string/edit_sheet_handle_cd">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@color/colorTextSecondary" />
        </FrameLayout>

    <!-- Pick Mode Toggle & Selector Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <ToggleButton
            android:id="@+id/btn_toggle_inspect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:textOn="@string/edit_pick_on"
            android:textOff="@string/edit_pick_off"
            android:checked="false"
            android:backgroundTint="@color/colorAccent"
            android:textColor="@color/colorOnAccent" />

        <TextView
            android:id="@+id/tv_selected_selector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="@color/colorTextPrimary"
            android:text="@string/edit_selected_none"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>


        <LinearLayout
            android:id="@+id/layout_sheet_peek_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_plugin_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/cancel"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@color/colorWhite"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_plugin_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/save"
                android:backgroundTint="@color/colorAccent"
                android:textColor="@color/colorOnAccent" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/scroll_bottom_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Parent / Child Traversal Buttons -->
                <LinearLayout
                    android:id="@+id/layout_traversal_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btn_select_parent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="@string/edit_select_parent"
                        android:backgroundTint="@color/colorPrimary"
                        android:textColor="@color/colorWhite"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_select_child"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="@string/edit_select_child"
                        android:backgroundTint="@color/colorPrimary"
                        android:textColor="@color/colorWhite"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- Action Config Panel -->
                <LinearLayout
                    android:id="@+id/layout_action_config"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="0dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/edit_action_type"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <RadioGroup
                        android:id="@+id/rg_action_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="4dp">

                        <RadioButton
                            android:id="@+id/rb_action_hidden"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/edit_action_hide"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rb_action_click"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/edit_action_click" />

                        <RadioButton
                            android:id="@+id/rb_action_color"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/edit_action_color" />

                    </RadioGroup>

                    <!-- Panel for Color setup (Visible only when 'Color' is selected) -->
                    <LinearLayout
                        android:id="@+id/layout_color_setup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/edit_color_hint"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btn_color_bg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="Background: none"
                            android:backgroundTint="@color/colorPrimary"
                            android:textColor="@color/colorWhite"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btn_color_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            tools:text="Text: none"
                            android:backgroundTint="@color/colorPrimary"
                            android:textColor="@color/colorWhite"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- Panel for Click Trigger setup (Visible only when 'Click Event' is selected) -->
                    <LinearLayout
                        android:id="@+id/layout_click_trigger_setup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/edit_trigger_label"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/sp_trigger_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/edit_area_label"
                            android:textSize="11sp" />

                        <com.hwanyu365.pagetune.ui.view.NoAutofillEditText
                            android:id="@+id/et_gesture_area"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/edit_area_hint"
                            android:textColor="@color/colorTextPrimary"
                            android:textColorHint="@color/colorTextSecondary"
                            android:inputType="number"
                            android:importantForAutofill="no"
                            android:privateImeOptions="com.samsung.android.inputmethod.disableAutofill=true,disableAutofill=true"
                            android:autofillHints="" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_add_action"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/edit_rule_add"
                        android:backgroundTint="@color/colorPrimary"
                        android:textColor="@color/colorWhite" />

                </LinearLayout>

                <!-- Actions list summary -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_rules_title"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:id="@+id/layout_actions_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/btn_set_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/edit_start_position_set"
                    android:backgroundTint="@color/colorPrimary"
                    android:textColor="@color/colorWhite"
                    android:textSize="11sp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
