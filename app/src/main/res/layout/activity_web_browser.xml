<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main WebView container -->
    <WebView
        android:id="@+id/wv_browser"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Progress indicator overlayed at the top -->
    <ProgressBar
        android:id="@+id/pb_browser_loading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:visibility="gone" />

    <!-- Floating GNB (Semitemporary Overlay at bottom) -->
    <LinearLayout
        android:id="@+id/layout_floating_gnb"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@color/scrim"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_gnb_prev"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/browser_prev"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/btn_gnb_next"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/browser_next"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <!-- Quick menu: handle, toolbar and Tune status share one top overlay -->
    <RelativeLayout
        android:id="@+id/layout_quick_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <ImageButton
            android:id="@+id/btn_quick_handle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="4dp"
            android:background="@drawable/bg_quick_handle"
            android:contentDescription="@string/quick_menu"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/onSurface" />

        <LinearLayout
            android:id="@+id/layout_quick_toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/btn_quick_handle"
            android:background="@color/scrim"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_quick_back"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quick_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/onSurface" />

        <ImageButton
            android:id="@+id/btn_quick_refresh"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quick_refresh"
            android:src="@drawable/ic_refresh"
            app:tint="@color/onSurface" />

        <ImageButton
            android:id="@+id/btn_quick_share"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quick_share"
            android:src="@drawable/ic_share"
            app:tint="@color/onSurface" />

        <ImageButton
            android:id="@+id/btn_quick_toggle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quick_tune_off"
            android:src="@drawable/ic_toggle_on"
            app:tint="@color/onSurface" />

        <ImageButton
            android:id="@+id/btn_quick_edit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quick_edit_tune"
            android:src="@drawable/ic_edit"
            app:tint="@color/onSurface" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_tune_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/btn_quick_handle"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:background="@color/scrim"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/onSurface"
            android:visibility="gone" />

    </RelativeLayout>

</RelativeLayout>
