<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/layout_edit_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- Top bar: Plugin name & Test URL -->
    <LinearLayout
        android:id="@+id/layout_edit_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@color/surfaceContainerLow">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/edit_hint_tune_name">

            <com.hwanyu365.pagetune.ui.view.NoAutofillEditText
                android:id="@+id/et_inp_pname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textNoSuggestions"
                android:importantForAutofill="no"
                android:privateImeOptions="com.samsung.android.inputmethod.disableAutofill=true,disableAutofill=true"
                android:autofillHints="" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_inp_taddr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/edit_hint_url">

                <com.hwanyu365.pagetune.ui.view.NoAutofillEditText
                    android:id="@+id/et_inp_taddr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri|textNoSuggestions"
                    android:importantForAutofill="no"
                    android:privateImeOptions="com.samsung.android.inputmethod.disableAutofill=true,disableAutofill=true"
                    android:autofillHints="" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btn_load_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:text="@string/edit_load" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_edit_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="4dp"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="@color/onSurface" />

        <TextView
            android:id="@+id/tv_edit_step_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/onSurfaceVariant" />

    </LinearLayout>

    <!-- Mid layout: WebView with Element Inspector overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/wv_inspector"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tv_inspector_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:background="@color/scrim"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/onSurface"
            android:text="@string/edit_pick_banner"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_load_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_load_error_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/onSurface" />

            <TextView
                android:id="@+id/tv_load_error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/onSurfaceVariant" />

            <Button
                android:id="@+id/btn_load_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="48dp"
                android:text="@string/load_error_retry" />

        </LinearLayout>

    </FrameLayout>

    </LinearLayout>

    <!-- Bottom sheet: handle, toggle and save/cancel stay visible when collapsed -->
    <LinearLayout
        android:id="@+id/layout_bottom_config_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surfaceContainerHigh"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        app:behavior_hideable="false"
        app:behavior_fitToContents="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <FrameLayout
            android:id="@+id/sheet_handle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@string/edit_sheet_handle_cd">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@color/onSurfaceVariant" />
        </FrameLayout>

    <!-- Pick Mode Toggle & Selector Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_inspect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:checkable="true"
            android:text="@string/edit_pick_off" />

        <TextView
            android:id="@+id/tv_selected_selector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textStyle="italic"
            android:textColor="@color/onSurface"
            android:text="@string/edit_selected_none"
            android:maxLines="3"
            android:ellipsize="end" />

    </LinearLayout>


        <LinearLayout
            android:id="@+id/layout_sheet_peek_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_plugin_cancel"
                style="?attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/cancel"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_plugin_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/save" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/scroll_bottom_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Parent / Child Traversal Buttons -->
                <LinearLayout
                    android:id="@+id/layout_traversal_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btn_select_parent"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="@string/edit_select_parent" />

                    <Button
                        android:id="@+id/btn_select_child"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="@string/edit_select_child" />

                </LinearLayout>

                <!-- Action Config Panel -->
                <LinearLayout
                    android:id="@+id/layout_action_config"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="0dp">

                    <Button
                        android:id="@+id/btn_selector_details"
                        style="?attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/edit_details_show" />

                    <TextView
                        android:id="@+id/tv_selector_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/onSurfaceVariant"
                        android:textIsSelectable="true"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/edit_action_type"
                        android:textAppearance="?attr/textAppearanceLabelLarge" />

                    <RadioGroup
                        android:id="@+id/rg_action_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="4dp">

                        <RadioButton
                            android:id="@+id/rb_action_hidden"
                            android:minHeight="48dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/edit_action_hide"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rb_action_click"
                            android:minHeight="48dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/edit_action_click" />

                        <RadioButton
                            android:id="@+id/rb_action_color"
                            android:minHeight="48dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/edit_action_color" />

                    </RadioGroup>

                    <!-- Panel for Color setup (Visible only when 'Color' is selected) -->
                    <LinearLayout
                        android:id="@+id/layout_color_setup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/edit_color_hint"
                            android:textAppearance="?attr/textAppearanceLabelLarge" />

                        <Button
                            android:id="@+id/btn_color_bg"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="Background: none" />

                        <Button
                            android:id="@+id/btn_color_text"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            tools:text="Text: none" />

                    </LinearLayout>

                    <!-- Panel for Click Trigger setup (Visible only when 'Click Event' is selected) -->
                    <LinearLayout
                        android:id="@+id/layout_click_trigger_setup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/edit_trigger_label"
                            android:textAppearance="?attr/textAppearanceLabelLarge" />

                        <Spinner
                            android:id="@+id/sp_trigger_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_marginBottom="4dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/edit_area_label"
                            app:placeholderText="@string/edit_area_hint">

                            <com.hwanyu365.pagetune.ui.view.NoAutofillEditText
                                android:id="@+id/et_gesture_area"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:importantForAutofill="no"
                                android:privateImeOptions="com.samsung.android.inputmethod.disableAutofill=true,disableAutofill=true"
                                android:autofillHints="" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_add_action"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/edit_rule_add" />

                </LinearLayout>

                <!-- Actions list summary -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_rules_title"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:id="@+id/layout_actions_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/btn_set_scroll"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/edit_start_position_set" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_pull_nav"
                    android:enabled="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/edit_pull_nav" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_pull_nav_note"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/onSurfaceVariant" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
